<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!-- LaTeX source editor (the PDF is shown in its own view, see below) -->
   <extension point="org.eclipse.ui.editors">
      <editor
            id="com.ectex.plugin.editors.EcTeXEditor"
            name="EcTeX LaTeX Editor"
            extensions="tex"
            class="com.ectex.plugin.editors.EcTeXEditor"
            contributorClass="org.eclipse.ui.editors.text.TextEditorActionContributor"
            default="true">
      </editor>
   </extension>

   <!-- PDF Preview view (Window > Show View > Other... > EcTeX) -->
   <extension point="org.eclipse.ui.views">
      <category
            id="com.ectex.plugin.views.category"
            name="EcTeX">
      </category>
      <view
            id="com.ectex.plugin.views.PdfView"
            name="PDF Preview"
            category="com.ectex.plugin.views.category"
            class="com.ectex.plugin.views.PdfView"
            allowMultiple="false"
            restorable="true">
      </view>
   </extension>

   <!-- Default position: right of the editor area (a hidden placeholder until the first .tex file is opened) -->
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="*">
         <view
               id="com.ectex.plugin.views.PdfView"
               relationship="right"
               relative="org.eclipse.ui.editorss"
               ratio="0.5"
               visible="false">
         </view>
      </perspectiveExtension>
   </extension>

   <!-- Key binding context: child of the text editor scope, so these bindings win over
        the global ones (Ctrl+F2 = terminate, Ctrl+F3 = quick outline, Ctrl+Space = content assist, Ctrl+B = build all, ...) -->
   <extension point="org.eclipse.ui.contexts">
      <context
            id="com.ectex.plugin.contexts.editor"
            name="EcTeX Editor"
            description="Active while an EcTeX LaTeX editor is in use"
            parentId="org.eclipse.ui.textEditorScope">
      </context>
      <!-- Child of the editor context: the PDF Preview view shares the editor's key bindings, so each
           command has a single binding that can be changed in Preferences > General > Keys -->
      <context
            id="com.ectex.plugin.contexts.pdfview"
            name="EcTeX PDF Preview"
            description="Active while the EcTeX PDF Preview view has the focus"
            parentId="com.ectex.plugin.contexts.editor">
      </context>
   </extension>

   <extension point="org.eclipse.ui.commands">
      <category
            id="com.ectex.plugin.category"
            name="EcTeX">
      </category>
      <command
            id="com.ectex.plugin.commands.build"
            name="Build PDF (pdflatex)"
            description="Run pdflatex on the active .tex file and refresh the PDF view"
            categoryId="com.ectex.plugin.category">
      </command>
      <command
            id="com.ectex.plugin.commands.bibtex"
            name="Run BibTeX"
            description="Run bibtex on the active .tex file (after a pdflatex run)"
            categoryId="com.ectex.plugin.category">
      </command>
      <command
            id="com.ectex.plugin.commands.setMainFile"
            name="Set as Main File"
            description="Use this .tex file as the main file of its project (right-click the file): build, BibTeX, PDF Preview and sync then work on it from every file of the project"
            categoryId="com.ectex.plugin.category">
      </command>
      <command
            id="com.ectex.plugin.commands.clearMainFile"
            name="Clear Main File"
            description="Remove the main file of the project (right-click the main file or the project), so each file is built on its own again"
            categoryId="com.ectex.plugin.category">
      </command>
      <command
            id="com.ectex.plugin.commands.convertToLatexProject"
            name="Convert to LaTeX Project"
            description="Turn the project into a LaTeX project (needed for a main file)"
            categoryId="com.ectex.plugin.category">
      </command>
      <command
            id="com.ectex.plugin.commands.removeLatexNature"
            name="Remove LaTeX Nature"
            description="Turn a LaTeX project back into a plain project (also clears its main file)"
            categoryId="com.ectex.plugin.category">
      </command>
      <command
            id="com.ectex.plugin.commands.sync"
            name="Synchronize (Forward / Inverse Search)"
            description="In the editor: jump to the PDF. In the PDF viewer: jump to the source"
            categoryId="com.ectex.plugin.category">
      </command>
      <command
            id="com.ectex.plugin.commands.bold"
            name="Bold \textbf{}"
            categoryId="com.ectex.plugin.category">
      </command>
      <command
            id="com.ectex.plugin.commands.italic"
            name="Italic \textit{}"
            categoryId="com.ectex.plugin.category">
      </command>
      <command
            id="com.ectex.plugin.commands.underline"
            name="Underline \underline{}"
            categoryId="com.ectex.plugin.category">
      </command>
      <command
            id="com.ectex.plugin.commands.emph"
            name="Emphasis \emph{}"
            categoryId="com.ectex.plugin.category">
      </command>
      <command
            id="com.ectex.plugin.commands.math"
            name="Inline Math $ $"
            categoryId="com.ectex.plugin.category">
      </command>
   </extension>

   <!-- Handlers are only active while an EcTeX editor is the active editor -->
   <extension point="org.eclipse.ui.handlers">
      <!-- build, bibtex and sync also work while the PDF view has the focus -->
      <handler
            commandId="com.ectex.plugin.commands.build"
            class="com.ectex.plugin.handlers.BuildHandler">
         <activeWhen>
            <or>
               <with variable="activeEditorId">
                  <equals value="com.ectex.plugin.editors.EcTeXEditor"/>
               </with>
               <with variable="activePartId">
                  <equals value="com.ectex.plugin.views.PdfView"/>
               </with>
            </or>
         </activeWhen>
      </handler>
      <handler
            commandId="com.ectex.plugin.commands.bibtex"
            class="com.ectex.plugin.handlers.BibtexHandler">
         <activeWhen>
            <or>
               <with variable="activeEditorId">
                  <equals value="com.ectex.plugin.editors.EcTeXEditor"/>
               </with>
               <with variable="activePartId">
                  <equals value="com.ectex.plugin.views.PdfView"/>
               </with>
            </or>
         </activeWhen>
      </handler>
      <handler
            commandId="com.ectex.plugin.commands.sync"
            class="com.ectex.plugin.handlers.SyncHandler">
         <activeWhen>
            <or>
               <with variable="activeEditorId">
                  <equals value="com.ectex.plugin.editors.EcTeXEditor"/>
               </with>
               <with variable="activePartId">
                  <equals value="com.ectex.plugin.views.PdfView"/>
               </with>
            </or>
         </activeWhen>
      </handler>
      <!-- the main file commands work on the selected file or project (Project Explorer), so no activeWhen -->
      <handler
            commandId="com.ectex.plugin.commands.setMainFile"
            class="com.ectex.plugin.handlers.MainFileHandler">
      </handler>
      <handler
            commandId="com.ectex.plugin.commands.clearMainFile"
            class="com.ectex.plugin.handlers.MainFileHandler">
      </handler>
      <handler
            commandId="com.ectex.plugin.commands.convertToLatexProject"
            class="com.ectex.plugin.handlers.LatexNatureHandler">
      </handler>
      <handler
            commandId="com.ectex.plugin.commands.removeLatexNature"
            class="com.ectex.plugin.handlers.LatexNatureHandler">
      </handler>
      <handler
            commandId="com.ectex.plugin.commands.bold"
            class="com.ectex.plugin.handlers.WrapHandler">
         <activeWhen>
            <with variable="activeEditorId">
               <equals value="com.ectex.plugin.editors.EcTeXEditor"/>
            </with>
         </activeWhen>
      </handler>
      <handler
            commandId="com.ectex.plugin.commands.italic"
            class="com.ectex.plugin.handlers.WrapHandler">
         <activeWhen>
            <with variable="activeEditorId">
               <equals value="com.ectex.plugin.editors.EcTeXEditor"/>
            </with>
         </activeWhen>
      </handler>
      <handler
            commandId="com.ectex.plugin.commands.underline"
            class="com.ectex.plugin.handlers.WrapHandler">
         <activeWhen>
            <with variable="activeEditorId">
               <equals value="com.ectex.plugin.editors.EcTeXEditor"/>
            </with>
         </activeWhen>
      </handler>
      <handler
            commandId="com.ectex.plugin.commands.emph"
            class="com.ectex.plugin.handlers.WrapHandler">
         <activeWhen>
            <with variable="activeEditorId">
               <equals value="com.ectex.plugin.editors.EcTeXEditor"/>
            </with>
         </activeWhen>
      </handler>
      <handler
            commandId="com.ectex.plugin.commands.math"
            class="com.ectex.plugin.handlers.WrapHandler">
         <activeWhen>
            <with variable="activeEditorId">
               <equals value="com.ectex.plugin.editors.EcTeXEditor"/>
            </with>
         </activeWhen>
      </handler>
   </extension>

   <!-- Default key bindings. Users can change every one of them in Window > Preferences > General > Keys
        (filter "EcTeX"). M1 is Ctrl on Windows and Linux (Command on macOS). -->
   <extension point="org.eclipse.ui.bindings">
      <key
            commandId="com.ectex.plugin.commands.build"
            contextId="com.ectex.plugin.contexts.editor"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+F2">
      </key>
      <key
            commandId="com.ectex.plugin.commands.bibtex"
            contextId="com.ectex.plugin.contexts.editor"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+F3">
      </key>
      <key
            commandId="com.ectex.plugin.commands.sync"
            contextId="com.ectex.plugin.contexts.editor"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+SPACE">
      </key>
      <key
            commandId="com.ectex.plugin.commands.bold"
            contextId="com.ectex.plugin.contexts.editor"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+B">
      </key>
      <key
            commandId="com.ectex.plugin.commands.italic"
            contextId="com.ectex.plugin.contexts.editor"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+I">
      </key>
      <key
            commandId="com.ectex.plugin.commands.underline"
            contextId="com.ectex.plugin.contexts.editor"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+U">
      </key>
      <key
            commandId="com.ectex.plugin.commands.emph"
            contextId="com.ectex.plugin.contexts.editor"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M2+E">
      </key>
      <key
            commandId="com.ectex.plugin.commands.math"
            contextId="com.ectex.plugin.contexts.editor"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M2+M">
      </key>
   </extension>

   <!-- "EcTeX" menu in the main menu bar. Always visible: items are enabled or disabled, never hidden. -->
   <extension point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu
               id="com.ectex.plugin.menu"
               label="EcTeX">
            <command
                  commandId="org.eclipse.ui.newWizard"
                  label="New LaTeX Project..."
                  style="push">
               <parameter
                     name="newWizardId"
                     value="com.ectex.plugin.wizards.newProject">
               </parameter>
            </command>
            <command
                  commandId="org.eclipse.ui.perspectives.showPerspective"
                  label="Open LaTeX Perspective"
                  style="push">
               <parameter
                     name="org.eclipse.ui.perspectives.showPerspective.perspectiveId"
                     value="com.ectex.plugin.perspectives.latex">
               </parameter>
            </command>
            <separator
                  name="com.ectex.plugin.menu.sepProject"
                  visible="true">
            </separator>
            <command
                  commandId="com.ectex.plugin.commands.build"
                  label="Build PDF"
                  style="push">
            </command>
            <command
                  commandId="com.ectex.plugin.commands.bibtex"
                  label="Run BibTeX"
                  style="push">
            </command>
            <command
                  commandId="com.ectex.plugin.commands.sync"
                  label="Forward / Inverse Search"
                  style="push">
            </command>
            <separator
                  name="com.ectex.plugin.menu.sep"
                  visible="true">
            </separator>
            <command
                  commandId="com.ectex.plugin.commands.bold"
                  label="Bold"
                  style="push">
            </command>
            <command
                  commandId="com.ectex.plugin.commands.italic"
                  label="Italic"
                  style="push">
            </command>
            <command
                  commandId="com.ectex.plugin.commands.underline"
                  label="Underline"
                  style="push">
            </command>
            <command
                  commandId="com.ectex.plugin.commands.emph"
                  label="Emphasis"
                  style="push">
            </command>
            <command
                  commandId="com.ectex.plugin.commands.math"
                  label="Inline Math"
                  style="push">
            </command>
         </menu>
      </menuContribution>

      <!-- Project right-click > Configure > Convert to LaTeX Project / Remove LaTeX Nature -->
      <menuContribution
            locationURI="popup:org.eclipse.ui.projectConfigure?after=additions">
         <command
               commandId="com.ectex.plugin.commands.convertToLatexProject"
               label="Convert to LaTeX Project"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="selection">
                  <count value="1"/>
                  <iterate ifEmpty="false">
                     <adapt type="org.eclipse.core.resources.IProject">
                        <not>
                           <test property="org.eclipse.core.resources.projectNature" value="com.ectex.plugin.latexNature"/>
                        </not>
                     </adapt>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
         <command
               commandId="com.ectex.plugin.commands.removeLatexNature"
               label="Remove LaTeX Nature"
               style="push">
            <visibleWhen checkEnabled="false">
               <with variable="selection">
                  <count value="1"/>
                  <iterate ifEmpty="false">
                     <adapt type="org.eclipse.core.resources.IProject">
                        <test property="org.eclipse.core.resources.projectNature" value="com.ectex.plugin.latexNature"/>
                     </adapt>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>

      <!-- Right-click a .tex file or a LaTeX project (Project Explorer, Navigator, Package Explorer), EcTeX submenu:
           - .tex file in a LaTeX project: Set as Main File (Clear Main File if it is the main file)
           - .tex file in a plain project: Convert to LaTeX Project (a main file needs a LaTeX project)
           - LaTeX project: Clear Main File (if it has one) and Remove LaTeX Nature -->
      <menuContribution
            locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <menu
               id="com.ectex.plugin.popup.explorer"
               label="EcTeX">
            <visibleWhen checkEnabled="false">
               <with variable="selection">
                  <count value="1"/>
                  <iterate ifEmpty="false">
                     <adapt type="org.eclipse.core.resources.IResource">
                        <or>
                           <test property="org.eclipse.core.resources.extension" value="tex"/>
                           <and>
                              <instanceof value="org.eclipse.core.resources.IProject"/>
                              <test property="org.eclipse.core.resources.projectNature" value="com.ectex.plugin.latexNature"/>
                           </and>
                        </or>
                     </adapt>
                  </iterate>
               </with>
            </visibleWhen>
            <command
                  commandId="com.ectex.plugin.commands.setMainFile"
                  label="Set as Main File"
                  style="push">
               <visibleWhen checkEnabled="false">
                  <with variable="selection">
                     <count value="1"/>
                     <iterate ifEmpty="false">
                        <adapt type="org.eclipse.core.resources.IResource">
                           <test property="org.eclipse.core.resources.extension" value="tex"/>
                           <test property="org.eclipse.core.resources.projectNature" value="com.ectex.plugin.latexNature"/>
                           <test property="com.ectex.plugin.isMainFile" value="false"/>
                        </adapt>
                     </iterate>
                  </with>
               </visibleWhen>
            </command>
            <command
                  commandId="com.ectex.plugin.commands.clearMainFile"
                  label="Clear Main File"
                  style="push">
               <visibleWhen checkEnabled="false">
                  <with variable="selection">
                     <count value="1"/>
                     <iterate ifEmpty="false">
                        <adapt type="org.eclipse.core.resources.IResource">
                           <or>
                              <test property="com.ectex.plugin.isMainFile" value="true"/>
                              <and>
                                 <instanceof value="org.eclipse.core.resources.IProject"/>
                                 <test property="com.ectex.plugin.hasMainFile" value="true"/>
                              </and>
                           </or>
                        </adapt>
                     </iterate>
                  </with>
               </visibleWhen>
            </command>
            <command
                  commandId="com.ectex.plugin.commands.convertToLatexProject"
                  label="Convert Project to LaTeX Project"
                  style="push">
               <visibleWhen checkEnabled="false">
                  <with variable="selection">
                     <count value="1"/>
                     <iterate ifEmpty="false">
                        <adapt type="org.eclipse.core.resources.IResource">
                           <test property="org.eclipse.core.resources.extension" value="tex"/>
                           <not>
                              <test property="org.eclipse.core.resources.projectNature" value="com.ectex.plugin.latexNature"/>
                           </not>
                        </adapt>
                     </iterate>
                  </with>
               </visibleWhen>
            </command>
            <command
                  commandId="com.ectex.plugin.commands.removeLatexNature"
                  label="Remove LaTeX Nature"
                  style="push">
               <visibleWhen checkEnabled="false">
                  <with variable="selection">
                     <count value="1"/>
                     <iterate ifEmpty="false">
                        <adapt type="org.eclipse.core.resources.IResource">
                           <instanceof value="org.eclipse.core.resources.IProject"/>
                           <test property="org.eclipse.core.resources.projectNature" value="com.ectex.plugin.latexNature"/>
                        </adapt>
                     </iterate>
                  </with>
               </visibleWhen>
            </command>
         </menu>
      </menuContribution>

      <!-- The same commands in the right-click menu of the EcTeX editor (they act on its file and project) -->
      <menuContribution
            locationURI="popup:#TextEditorContext?after=additions">
         <menu
               id="com.ectex.plugin.popup.editor"
               label="EcTeX">
            <visibleWhen checkEnabled="false">
               <and>
                  <with variable="activeEditorId">
                     <equals value="com.ectex.plugin.editors.EcTeXEditor"/>
                  </with>
                  <with variable="activeEditorInput">
                     <adapt type="org.eclipse.core.resources.IFile"/>
                  </with>
               </and>
            </visibleWhen>
            <command
                  commandId="com.ectex.plugin.commands.setMainFile"
                  label="Set as Main File"
                  style="push">
               <visibleWhen checkEnabled="false">
                  <with variable="activeEditorInput">
                     <adapt type="org.eclipse.core.resources.IResource">
                        <test property="org.eclipse.core.resources.projectNature" value="com.ectex.plugin.latexNature"/>
                        <test property="com.ectex.plugin.isMainFile" value="false"/>
                     </adapt>
                  </with>
               </visibleWhen>
            </command>
            <command
                  commandId="com.ectex.plugin.commands.clearMainFile"
                  label="Clear Main File"
                  style="push">
               <visibleWhen checkEnabled="false">
                  <with variable="activeEditorInput">
                     <adapt type="org.eclipse.core.resources.IResource">
                        <test property="com.ectex.plugin.hasMainFile" value="true"/>
                     </adapt>
                  </with>
               </visibleWhen>
            </command>
            <command
                  commandId="com.ectex.plugin.commands.convertToLatexProject"
                  label="Convert Project to LaTeX Project"
                  style="push">
               <visibleWhen checkEnabled="false">
                  <with variable="activeEditorInput">
                     <adapt type="org.eclipse.core.resources.IResource">
                        <not>
                           <test property="org.eclipse.core.resources.projectNature" value="com.ectex.plugin.latexNature"/>
                        </not>
                     </adapt>
                  </with>
               </visibleWhen>
            </command>
         </menu>
      </menuContribution>
   </extension>

   <!-- LaTeX project nature: a project with it is a "LaTeX project" and can have a main file -->
   <extension
         id="latexNature"
         name="LaTeX Project"
         point="org.eclipse.core.resources.natures">
      <runtime>
         <run class="com.ectex.plugin.project.LatexNature"/>
      </runtime>
   </extension>

   <!-- File > New > Other > EcTeX > LaTeX Project (also EcTeX > New LaTeX Project... in the menu bar) -->
   <extension point="org.eclipse.ui.newWizards">
      <category
            id="com.ectex.plugin.wizards.category"
            name="EcTeX">
      </category>
      <wizard
            id="com.ectex.plugin.wizards.newProject"
            name="LaTeX Project"
            category="com.ectex.plugin.wizards.category"
            class="com.ectex.plugin.wizards.NewLatexProjectWizard"
            finalPerspective="com.ectex.plugin.perspectives.latex"
            project="true">
         <description>
            Creates a LaTeX project with a main .tex file and, optionally, a bibliography file.
         </description>
      </wizard>
   </extension>

   <!-- Window > Perspective > Open Perspective > Other... > LaTeX -->
   <extension point="org.eclipse.ui.perspectives">
      <perspective
            id="com.ectex.plugin.perspectives.latex"
            name="LaTeX"
            class="com.ectex.plugin.perspectives.LatexPerspectiveFactory">
      </perspective>
   </extension>

   <!-- Properties used by the visibility conditions of the context menus -->
   <extension point="org.eclipse.core.expressions.propertyTesters">
      <propertyTester
            id="com.ectex.plugin.propertyTesters.mainFile"
            type="org.eclipse.core.resources.IResource"
            namespace="com.ectex.plugin"
            properties="isMainFile,hasMainFile"
            class="com.ectex.plugin.project.MainFileTester">
      </propertyTester>
   </extension>

   <!-- Shows " [main file]" after the name of the main file in the explorers.
        Can be switched off in Preferences > General > Appearance > Label Decorations. -->
   <extension point="org.eclipse.ui.decorators">
      <decorator
            id="com.ectex.plugin.decorators.mainFile"
            label="EcTeX main file"
            lightweight="true"
            adaptable="true"
            state="true"
            class="com.ectex.plugin.project.MainFileDecorator">
         <enablement>
            <objectClass name="org.eclipse.core.resources.IFile"/>
         </enablement>
         <description>
            Appends [main file] to the main file of a LaTeX project (set with right-click &gt; EcTeX &gt; Set as Main File).
         </description>
      </decorator>
   </extension>

   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="com.ectex.plugin.preferences.main"
            name="EcTeX"
            class="com.ectex.plugin.preferences.EcTeXPreferencePage">
      </page>
   </extension>

   <extension point="org.eclipse.core.runtime.preferences">
      <initializer
            class="com.ectex.plugin.preferences.PreferenceInitializer">
      </initializer>
   </extension>

</plugin>
